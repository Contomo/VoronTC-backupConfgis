# ───| Tools MCU |───
[mcu et5]
canbus_uuid: 9422cd1b01cb

[temperature_sensor T5_mcu]
sensor_type: temperature_mcu
sensor_mcu: et5

[gcode_macro T5]
variable_active: 0
variable_color: ""
variable_tool_number: 5
gcode:
    SELECT_TOOL T={tool_number} {rawparams}

[tool T5]
detection_pin: ^!et5:PB6
tool_number: 5
extruder: extruder5
fan: T5_partfan

[tool_probe T5]
pin: ^et5:PB6
tool: 5
z_offset: 0
speed: 10 #20.0 #5
lift_speed: 75.0 #50
samples: 3
samples_result: median
sample_retract_dist: 1.5
samples_tolerance: 0.025
samples_tolerance_retries: 8
activate_gcode:
    _TAP_PROBE_ACTIVATE
deactivate_gcode:
    _TAP_PROBE_DEACTIVATE

# ───| Extruder |───
[extruder5]
step_pin: et5: PD0
dir_pin: et5: PD1
enable_pin: !et5: PD2
microsteps: 32
full_steps_per_rotation: 200
rotation_distance: 5.6
max_extrude_only_distance: 1400.0
max_extrude_only_velocity: 75.0
max_extrude_only_accel: 1500
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: et5: PB13
sensor_type: Generic 3950
sensor_pin: et5: PA3

min_temp: 0
max_temp: 300

max_extrude_cross_section: 0.64
control: mpc
heater_power: 63  
cooling_fan: fan_generic T5_partfan
block_heat_capacity=11.8866
sensor_responsiveness=0.0924423
ambient_transfer=0.139078
fan_ambient_transfer=0.139078, 0.142699, 0.155066, 0.163174, 0.166841
ambient_temp_sensor: heater_chamber_fan chamber
smooth_time: 0.2

[tmc2209 extruder5]
uart_pin: et5: PA15
sense_resistor: 0.11 # default for klipper, kalico requires it.
run_current: 0.575
stealthchop_threshold: 999999

# ───| Fans |───
[fan_generic T5_partfan]
pin: et5:PA1

[heater_fan T5_hotend_fan]
pin: et5:PA0
heater: extruder5
heater_temp: 65.0

# ───| Accelerometer |───
[adxl345 T5]
cs_pin: et5: PB12
spi_software_sclk_pin: et5: PB10
spi_software_mosi_pin: et5: PB11
spi_software_miso_pin: et5: PB2
axes_map: x,z,-y

# ───| LEDs |───

[neopixel T5_leds]
pin: et5:PD3
chain_count: 10
color_order: GRB, GRB, GRB, GRB, GRB, GRB, GRB, GRB, GRBW, GRBW
initial_RED: 0.0
initial_GREEN: 0.0
initial_BLUE: 0.0
initial_WHITE: 0.0

[gcode_macro _T5_vars]
variable_logo_led_name:         "T5_leds"
variable_logo_idx:              "1,2,3,4,5,6,7,8"
variable_logo_brightness:       "0.7,0.7,0.7,0.7,0.7,0.7,0.7,0.7"
variable_nozzle_led_name:       "T5_leds"
variable_nozzle_idx:            "9,10"
variable_nozzle_brightness:     "1,1" # add it or leave it, defaults to 1.0 anyways.
gcode:



