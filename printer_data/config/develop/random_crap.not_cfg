# OLD BUT GOOD FOR GUIDANCE
# #
# #{%- macro _angle_deg(ax,ay,bx,by,cx,cy,m) -%}
#     {%- set ux, uy = ax - bx, ay - by -%}
#     {%- set vx, vy = cx - bx, cy - by -%}
#     {%- set dot = ux*vx + uy*vy -%}
#     {%- set det = ux*vy - uy*vx -%}
#     {%- set a = m.degrees(m.atan2(det, dot)) -%}
#     { a if a>=0 else -a }
# {%- endmacro -%}
# 
# {%- macro _simplify_line(line, min_len, angle_keep_deg, m) -%}
#     {%- if line and (line|length) >= 3 -%}
#         {%- set out = [] -%}
#         {%- set _ = out.append(line[0]) -%}
#         {%- for i in range(1, line|length-1) -%}
#             {%- set ax, ay = line[i-1][0]|float, line[i-1][1]|float -%}
#             {%- set bx, by = line[i][0]|float,   line[i][1]|float   -%}
#             {%- set cx, cy = line[i+1][0]|float, line[i+1][1]|float -%}
#             {%- set d1 = m.hypot(bx-ax, by-ay) -%}
#             {%- set d2 = m.hypot(cx-bx, cy-by) -%}
#             {%- set turn = _angle_deg(ax,ay,bx,by,cx,cy,m)|float -%}
#             {%- set keep = (d1>=min_len) or (d2>=min_len) or (turn>=angle_keep_deg) -%}
#             {%- set _ = out.append([bx,by]) if keep -%}
#         {%- endfor -%}
#         {%- set _ = out.append(line|last) -%}
#         {%- set _ = line.clear() -%}
#         {%- set _ = line.extend(out) -%}
#     {%- endif -%}
# {%- endmacro -%}
# 
# {%- macro _densify_line(line, max_len, m) -%}
#     {%- for idx in range(line|length - 1, 0, -1) if line and (line|length) >= 2 -%}
#         {%- set ax, ay = line[idx-1][0]|float, line[idx-1][1]|float -%}
#         {%- set bx, by = line[idx][0]|float,   line[idx][1]|float   -%}
#         {%- set dx, dy = bx-ax, by-ay -%}
#         {%- set dist   = m.hypot(dx, dy) -%}
#         {%- if dist > max_len -%}
#             {%- set steps = (dist/max_len)|round(0,'ceil')|int - 1 -%}
#             {%- for k in range(steps, 0, -1) if steps >= 1 -%}
#                 {%- set t = (k / (steps + 1)) -%}
#                 {%- set nx = ax + dx*t -%}
#                 {%- set ny = ay + dy*t -%}
#                 {%- set _ = line.insert(idx, [nx, ny]) -%}
#             {%- endfor -%}
#         {%- endif -%}
#     {%- endfor -%}
# {%- endmacro -%}
# 
# {%- macro _round_line(line, dec) -%}
#     {%- for i in range(line|length) if dec is not none and line and (line|length) >= 1 -%}
#         {%- set x = line[i][0]|round(dec) -%}
#         {%- set y = line[i][1]|round(dec) -%}
#         {%- set _ = line.__setitem__(i, [x,y]) -%}
#     {%- endfor -%}
# {%- endmacro -%}
