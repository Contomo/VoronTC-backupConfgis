[gcode_macro _RASTER_TOOLS_OLD]
gcode:
    # --- INTERNAL LIBRARY: Not meant for direct execution ---
    {%- set _ = missing_context_please_import_with_context_or_define_printer() if not printer -%}
    {%- set pp   = printer.printer -%}
    {%- set gbl  = pp.__class__.__init__.__globals__ -%}
    {%- set np   = gbl.importlib.import_module('numpy') -%}
    {%- set math = gbl.importlib.import_module('math') -%}

    {%- macro _key(p) -%}{ "%.4f,%.4f" % (p[0], p[1]) }{%- endmacro -%}

    # Populates `out_lut` list with the Marching Squares Lookup Table.
    {%- macro generate_marching_squares_lut(out_lut) -%}
        {%- for i in range(16) -%}
            {%- set midpoints = [] -%}
            {%- set _ = midpoints.append((0.5, 0.0)) if (i // 8 % 2) != (i // 4 % 2) -%}
            {%- set _ = midpoints.append((1.0, 0.5)) if (i // 4 % 2) != (i // 2 % 2) -%}
            {%- set _ = midpoints.append((0.5, 1.0)) if (i // 2 % 2) != (i % 2)      -%}
            {%- set _ = midpoints.append((0.0, 0.5)) if (i % 2)      != (i // 8 % 2) -%}
            {%- set segments = [] -%}
            {%- set _ = segments.append([midpoints[0], midpoints[1]]) if midpoints|length >= 2 -%}
            {%- set _ = segments.append([midpoints[2], midpoints[3]]) if midpoints|length == 4 -%}
            {%- set _ = out_lut.append(segments) -%}
        {%- endfor -%}
    {%- endmacro -%}

    # Populates `out_data` with the raster grid and its metadata.
    {%- macro rasterize_lines(out_data, layer_lines, resolution) -%}
        {%- set flat = layer_lines|sum(start=[]) -%}
        {%- set x_coords, y_coords = flat|map(attribute='x')|list, flat|map(attribute='y')|list -%}
        {%- set x_min, x_max = (x_coords|min)-resolution, (x_coords|max)+resolution -%}
        {%- set y_min, y_max = (y_coords|min)-resolution, (y_coords|max)+resolution -%}
        {%- set grid_w = ((x_max - x_min) / resolution)|round(0, 'ceil')|int -%}
        {%- set grid_h = ((y_max - y_min) / resolution)|round(0, 'ceil')|int -%}
        {%- set grid = np.zeros((grid_h+2, grid_w+2), dtype=np.int8) -%}
        {%- set pad = 1 -%}
        {%- for segment in layer_lines -%}
            {%- for i in range(segment|length - 1) -%}
                {%- set p1, p2 = segment[i], segment[i+1] -%}
                {%- set dist = math.hypot(p2.x - p1.x, p2.y - p1.y) -%}
                {%- set steps = (dist / (resolution*0.5))|round(0, 'ceil')|int + 1 -%}
                {%- for s in range(steps + 1) -%}
                    {%- set t = s / steps -%}
                    {%- set x, y = p1.x+t*(p2.x-p1.x), p1.y+t*(p2.y-p1.y) -%}
                    {%- set gx, gy = (((x-x_min)/resolution)|int)+pad, (((y-y_min)/resolution)|int)+pad -%}
                    {%- if 0 <= gx < (grid_w+2) and 0 <= gy < (grid_h+2) -%}
                        {%- set _ = grid.__setitem__((gy, gx), 1) -%}
                    {%- endif -%}
                {%- endfor -%}
            {%- endfor -%}
        {%- endfor -%}
        {%- set _ = out_data.update({'grid':grid, 'w':grid_w, 'h':grid_h, 'x_min':x_min, 'y_min':y_min, 'pad':pad}) -%}
    {%- endmacro -%}

    # Populates `out_segments` with contour segments from the raster data.
    {%- macro extract_contour_segments(out_segments, raster_data, resolution, lut) -%}
        {%- for y in range(raster_data.h + 1) -%}
            {%- for x in range(raster_data.w + 1) -%}
                {%- set g = raster_data.grid -%}
                {%- set case = (g[y,x]*8)+(g[y,x+1]*4)+(g[y+1,x+1]*2)+g[y+1,x] -%}
                {%- for p1_off, p2_off in lut[case] -%}
                    {%- set p1x = raster_data.x_min + (x+p1_off[0]-raster_data.pad)*resolution -%}
                    {%- set p1y = raster_data.y_min + (y+p1_off[1]-raster_data.pad)*resolution -%}
                    {%- set p2x = raster_data.x_min + (x+p2_off[0]-raster_data.pad)*resolution -%}
                    {%- set p2y = raster_data.y_min + (y+p2_off[1]-raster_data.pad)*resolution -%}
                    {%- set k1, k2 = _key([p1x,p1y]), _key([p2x,p2y]) -%}
                    {%- set _ = out_segments.pop(k2) if k2 in out_segments else out_segments.update({k1:[p2x,p2y]}) -%}
                {%- endfor -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endmacro -%}

    # Populates `out_polygons` list by chaining segments from `segments_in`.
    {%- macro chain_segments(out_polygons, segments_in) -%}
        {%- set active = segments_in.copy() -%}
        {%- for start_key in segments_in.keys() if start_key in active -%}
            {%- set start_point = start_key.split(',')|map('float')|list -%}
            {%- set poly = [start_point] -%}
            {%- set current_key = start_key -%}
            {%- set is_open = namespace(v=False) -%}
            {%- for _ in range(active|length + 1) if not is_open.v -%}
                {%- set next_point = active.pop(current_key, None) -%}
                {%- if next_point is none -%}
                    {%- set is_open.v = True -%}
                {%- else -%}
                    {%- set _ = poly.append(next_point) -%}
                    {%- if _key(next_point) == start_key -%}
                        {%- set _ = out_polygons.append(poly) if poly|length > 2 -%}
                        {%- set is_open.v = True -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
        {%- endfor -%}
    {%- endmacro -%}


[gcode_macro _GCODE_TOOLS]
gcode:
    {% set _ = missing_context_please_import_with_context_or_define_printer() if not printer %}
    {% set gbl = printer.printer.__class__.__init__.__globals__ %}
    {% set np  = gbl.importlib.import_module('numpy') -%}
    {% set io  = gbl.importlib.import_module('io') %}
    {% set os  = gbl.importlib.import_module('os') %}
    {% set re  = gbl.importlib.import_module('re') %}

    {% set error = action_raise_error %}

    # ------------------------------------------------------------
    {%- macro get_file_path(file_path='') -%}
        {%- set path = printer.virtual_sdcard.get('file_path', '') -%}
        {%- if not path -%}
            {%- set base = printer.configfile.settings.virtual_sdcard.get('path', '') -%}
            {%- set name = printer.print_stats.filename -%}
            {%- set path = (base ~ '/' ~ name) if (base and name) else '' -%}
        {%- endif -%}
        {%- set path = file_path if file_path else path -%}
        {%- set path = os.path.expanduser(path) if path and not (os.path.exists(path) and os.path.isfile(path)) else path -%}
        { path }
    {%- endmacro -%}

    {% set __rw_state = {} %}
    {%- macro read_gcode_lines(path='',
                              kbytes=1024,
                              offset=none,
                              reset=False) -%}
        {%- set _bytes = kbytes * 1024 -%}

        {%- macro _init_file(path='', offset=0) -%}
            {%- set _size = os.path.getsize(path)|int -%}
            {%- set _ = __rw_state.update({ path: {
                'size': _size,
                'current_offset': [[offset|int(0), 0]|max, _size]|min
            } }) -%}
        {%- endmacro -%}
    
        {%- if path and os.path.exists(path) and os.path.isfile(path) -%}
            {%- set _ = _init_file(path, offset) 
                        if path not in __rw_state or offset is not none or reset -%}
            {%- if not reset -%}
                {%- set cur_pointer = __rw_state[path].current_offset -%}
                {%- set size        = __rw_state[path].size -%}
                {%- if cur_pointer < size -%}
                    {%- set to_read     = [ _bytes, size - cur_pointer ]|min -%}
                    {%- set file_handle = io.open(path, 'r', encoding='utf-8', errors='ignore') -%}
                    {%- set _           = file_handle.seek(cur_pointer) -%}
                    {%- set data        = file_handle.read(to_read) or '' -%}
                    {%- set end_marker  = data.rfind('\n') -%}
                    {%- set new_pointer = size -%}
                    {%- if end_marker == -1 -%}
                        {%- set _ = error('read_gcode_lines: window has no newline before EOF, ' ~ 
                                        '(either the file is broken, or the chunk size too small)') 
                                        if error is callable and cur_pointer + to_read != size -%}
                    {%- else -%}
                        {%- set data        = data[:end_marker] -%}
                        {%- set new_pointer = cur_pointer + end_marker + 1 -%}
                    {%- endif -%}
                    {%- set _ = _init_file(path, new_pointer) -%}
                    { data or '' }
                {%- endif -%}
            {%- endif -%}
        {%- else -%}
            {%- set _ = error('read_file: error reading file, (''' ~ path ~ ''') does not exist.') -%}
        {%- endif -%}
    {%- endmacro -%}

    # ------------------------------------------------------------
    {%- macro _parse_line(line, gcode_params) -%}
        {% set _ = gcode_params.clear() %}
        {% set clean_line = line.split(';')[0].strip() %}
        {% for part in clean_line.split() if clean_line %}
            {% set key, value = part[0]|upper, part[1:]|float(none) %}
                {% set _ = gcode_params.update({key: value}) if value %}
                {% set _ = gcode_params.update({key: part[1:]}) if not value and key in ['G', 'M'] %}
        {% endfor %}
    {%- endmacro -%}

    {%- macro _update_state(gcode_params, state) -%}

        {%- macro _handle_absolute_relative(gcode_params, state) -%}
            {% set  g_code = gcode_params.get('G', -1)|int(-1) %}
            {% set  m_code = gcode_params.get('M', -1)|int(-1) %}
            {% if   g_code == 91 %}{% set state.relative_pos = True %}
            {% elif g_code == 90 %}{% set state.relative_pos = False %}{% endif %}
            {% if   m_code == 83 %}{% set state.relative_ext = True %}
            {% elif m_code == 82 %}{% set state.relative_ext = False %}{% endif %}
        {%- endmacro -%}

        {% set state.last_pos = state.pos.copy() %}
        { _handle_absolute_relative(gcode_params, state) }
        {% for axis in ['X', 'Y', 'Z', 'E'] if gcode_params.get('G', -1)|int(-1) == 92 
                                            and axis in gcode_params %}
            {% set _ = state.pos.update({axis|lower: gcode_params[axis]|round(4)}) %}
        {% endfor %}
        {% for axis in ['X', 'Y', 'Z', 'E'] if axis in gcode_params %}
            {% set rel_marker = state.relative_ext if axis == 'E' else state.relative_pos %}
            {% set base_pos = state.pos[axis|lower] if rel_marker else 0 %}
            {% set _ = state.pos.update({axis|lower: (base_pos + gcode_params[axis])|round(4) }) %}
        {% endfor %}
    {%- endmacro -%}

    {%- macro parse_layer_gcode(list_out=[],
                                file_path='',
                                z_height=0.0,
                                z_tolerance=0.005,
                                z_stop_offset=1.0) -%}
        {%- macro _process_chunk(state, z_min, z_max, z_stop) -%}
            {% set chunk = read_gcode_lines(path=path, kbytes=64) %}
            {% if chunk and not state.stop_parsing %}
                {% set gcode_params = {} %}
                {% for line in chunk.split('\n') if not state.stop_parsing %}
                    {% set _ = _parse_line(line, gcode_params) %}
                    {% if gcode_params %}
                        {% set _ = _update_state(gcode_params, state) %}
                        {% set _ = _process_move(gcode_params, state, z_min, z_max) %}
                        {% set state.stop_parsing = True if state.pos.z > z_stop else state.stop_parsing %}
                    {% endif %}
                {% endfor %}
                { _process_chunk(state, z_min, z_max, z_stop) if not state.stop_parsing else '' }
            {% endif %}
        {%- endmacro -%}

        {%- macro _process_move(gcode_params, state, z_min, z_max) -%}
            {% set is_in_layer = z_min <= state.pos.z <= z_max %}
            {% set is_extruding = 'E' in gcode_params and state.pos.e > state.last_pos.e %}
            {% set is_printing_move = is_in_layer and is_extruding %}
            
            {% if state.is_printing %}
                {% if is_printing_move %}
                    {% set _ = state.current_line.append(state.pos.copy()) %}
                {% else %}
                    {% set _ = list_out.append(state.current_line) if state.current_line|length > 1 %}
                    {% set state.is_printing = False %}{% set state.current_line = none %}
                {% endif %}
            {% elif is_printing_move %}
                {% set state.is_printing = True %}
                {% set state.current_line = [state.last_pos.copy(), state.pos.copy()] %}
            {% endif %}
        {%- endmacro -%}

        {% set state = namespace(
            pos={'x':0.0, 'y':0.0, 'z':0.0, 'e':0.0},
            last_pos={'x':0.0, 'y':0.0, 'z':0.0, 'e':0.0},
            relative_pos=False, relative_ext=False,
            stop_parsing=False, is_printing=False, current_line=None,
        ) %}
        {% set path = get_file_path(file_path=file_path) %}
        {% if path %}
            {% set z_min = z_height - z_tolerance %}
            {% set z_max = z_height + z_tolerance %}
            {% set z_stop = z_height + z_stop_offset %}
            {%- set _ = read_gcode_lines(path=path, reset=True) -%}
            { _process_chunk(state, z_min, z_max, z_stop) }
            
            {% set _ = list_out.append(state.current_line) if state.is_printing and state.current_line|length > 1 %}
        {% endif %}
    {%- endmacro -%}

    {%- macro find_first_layer_z(file_path='', 
                                 extrusion_threshold=1.0, 
                                 max_scan_z=0.50, 
                                 min_scan_z=0.005) -%}
        {%- macro _scan_chunk(state, path) -%}
            {%- set state.is_starting = False -%}
            {%- set chunk = read_gcode_lines(path=path,
                                             kbytes=64) -%}
            {%- if chunk and not state.stop_parsing -%}
                {%- set gcode_params = {} -%}
                {%- for line in chunk.split('\n') if not state.stop_parsing -%}
                    {%- set _ = _parse_line(line,
                                            gcode_params) -%}
                    {%- if gcode_params -%}
                        {%- set _ = _update_state(gcode_params,
                                                  state) -%}
                        {%- set d_e = (state.pos.e - state.last_pos.e) if state.pos.e > state.last_pos.e else 0.0 -%}
                        {%- set z_val = state.pos.z|round(3) -%}
                        {%- if z_val >= min_scan_z and d_e > 0 -%}
                            {%- set old_tot = state.z_totals.get(z_val, 0.0) -%}
                            {%- set new_tot = old_tot + d_e -%}
                            {%- set _ = state.z_totals.update({ z_val: new_tot }) -%}
                            
                            {%- if old_tot < extrusion_threshold and new_tot >= extrusion_threshold -%}
                                {%- set state.valid_layer_count = state.valid_layer_count + 1 -%}
                            {%- endif -%}

                            {%- if z_val > max_scan_z or state.valid_layer_count >= 3 -%}
                                {%- set state.stop_parsing = True -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endif -%}
                {%- endfor -%}
                { _scan_chunk(state, path) if not state.stop_parsing else '' }
            {%- endif -%}
        {%- endmacro -%}

        {%- set state = namespace(
            pos={'x':0.0, 'y':0.0, 'z':0.0, 'e':0.0},
            last_pos={'x':0.0, 'y':0.0, 'z':0.0, 'e':0.0},
            relative_pos=False, relative_ext=False,
            z_totals={}, 
            stop_parsing=False,
            is_starting=True,
            valid_layer_count=0
        ) -%}

        {%- set path = get_file_path(file_path=file_path) -%}
        {%- if path -%}
            {%- set _ = read_gcode_lines(path=path, reset=True) -%}
            { _scan_chunk(state, path) }
            {%- set result = state.z_totals.items()|selectattr(1, 'ge', extrusion_threshold)
                                                   |map(attribute=0)|map('float')
                                                   |sort|first -%}
            { result or '' }
        {%- endif -%}
    {%- endmacro -%}